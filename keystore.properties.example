# Copy this file to keystore.properties and fill values locally.
# keystore.properties is gitignored. Never commit the real keystore or passwords.

PLAY_UPLOAD_STORE_FILE=/path/to/socialviewer-upload.jks
PLAY_UPLOAD_STORE_PASSWORD=replace-me
PLAY_UPLOAD_KEY_ALIAS=socialviewer-upload
PLAY_UPLOAD_KEY_PASSWORD=replace-me
