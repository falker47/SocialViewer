# Copy this file to keystore.properties and fill values locally.
# keystore.properties is gitignored. Never commit the real keystore or passwords.
# The release signing config expects a JKS upload keystore.
#
# If either password contains characters that are unsafe to persist through the
# local Java .properties encoding path, leave the password values blank here
# and provide PLAY_UPLOAD_STORE_PASSWORD / PLAY_UPLOAD_KEY_PASSWORD as
# process-local environment variables for the publish build.

PLAY_UPLOAD_STORE_FILE=/path/to/socialviewer-upload.jks
PLAY_UPLOAD_STORE_PASSWORD=replace-me
PLAY_UPLOAD_KEY_ALIAS=socialviewer-upload
PLAY_UPLOAD_KEY_PASSWORD=replace-me
