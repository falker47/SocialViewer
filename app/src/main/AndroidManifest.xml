<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Social Viewer"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SocialViewer"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- User-managed deep links. Social Viewer cannot verify provider-owned domains. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="tiktok.com" />
                <data android:scheme="https" android:host="www.tiktok.com" />
                <data android:scheme="https" android:host="m.tiktok.com" />
                <data android:scheme="https" android:host="vm.tiktok.com" />
                <data android:scheme="https" android:host="vt.tiktok.com" />
            </intent-filter>

            <!-- Only Instagram content types supported by InstagramProvider are claimed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="instagram.com" android:pathPrefix="/p/" />
                <data android:scheme="https" android:host="www.instagram.com" android:pathPrefix="/p/" />
                <data android:scheme="https" android:host="instagram.com" android:pathPrefix="/reel/" />
                <data android:scheme="https" android:host="www.instagram.com" android:pathPrefix="/reel/" />
            </intent-filter>

            <!--
                Threads shorthand URLs can be constrained safely on every supported Android
                version. Canonical /@user/post/... links remain paste/Share-only because the
                legacy path matcher cannot express exactly one username segment without
                overclaiming profile/feed surfaces.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="threads.com" android:pathPrefix="/t/" />
                <data android:scheme="https" android:host="www.threads.com" android:pathPrefix="/t/" />
                <data android:scheme="https" android:host="threads.net" android:pathPrefix="/t/" />
                <data android:scheme="https" android:host="www.threads.net" android:pathPrefix="/t/" />
            </intent-filter>

            <!--
                Reddit direct links are limited to single-content routes that can be expressed
                safely with the legacy pathPattern matcher used across minSdk 26+. Generic
                subreddit/profile/feed surfaces are intentionally not claimed.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="reddit.com" />
                <data android:scheme="https" android:host="www.reddit.com" />

                <!-- Canonical post permalink, with optional slug or one explicit comment. -->
                <data android:pathPattern="/r/..*/comments/..*/" />
                <data android:pathPattern="/r/..*/comments/..*/..*/" />
                <data android:pathPattern="/r/..*/comments/..*/..*/..*/" />

                <!-- Reddit share aliases already resolved safely inside RedditProvider. -->
                <data android:pathPattern="/s/..*" />
                <data android:pathPattern="/r/..*/s/..*" />
                <data android:pathPattern="/u/..*/s/..*" />
                <data android:pathPattern="/user/..*/s/..*" />
            </intent-filter>

            <!-- redd.it is a dedicated short-permalink host; keep it separate from reddit.com. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="redd.it"
                    android:pathPattern="/..*" />
            </intent-filter>

            <!-- Only single-Pin Pinterest paths are claimed. pin.it aliases stay paste/Share-only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="pinterest.com" android:pathPrefix="/pin/" />
                <data android:scheme="https" android:host="www.pinterest.com" android:pathPrefix="/pin/" />
            </intent-filter>

            <!-- Only Bluesky single-post paths are claimed; profile pages are not. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="bsky.app"
                    android:pathPattern="/profile/.*/post/.*" />
            </intent-filter>

            <!-- Fallback: share a public link/text directly to Social Viewer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
