<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Social Viewer"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SocialViewer"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- User-managed deep links. Social Viewer cannot verify provider-owned domains. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="tiktok.com" />
                <data android:scheme="https" android:host="www.tiktok.com" />
                <data android:scheme="https" android:host="m.tiktok.com" />
                <data android:scheme="https" android:host="vm.tiktok.com" />
                <data android:scheme="https" android:host="vt.tiktok.com" />
            </intent-filter>

            <!-- Only Instagram content types supported by InstagramProvider are claimed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="instagram.com" android:pathPrefix="/p/" />
                <data android:scheme="https" android:host="www.instagram.com" android:pathPrefix="/p/" />
                <data android:scheme="https" android:host="instagram.com" android:pathPrefix="/reel/" />
                <data android:scheme="https" android:host="www.instagram.com" android:pathPrefix="/reel/" />
            </intent-filter>

            <!-- Facebook Reels plus the narrow share-link aliases supported by the local
                 browser-assisted resolver are claimed for direct opening. Canonical individual
                 post paths remain paste/share only because the legacy manifest matcher cannot
                 express exactly one owner segment without overmatching. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="facebook.com" android:pathPrefix="/reel/" />
                <data android:scheme="https" android:host="www.facebook.com" android:pathPrefix="/reel/" />
                <data android:scheme="https" android:host="facebook.com" android:pathPrefix="/share/p/" />
                <data android:scheme="https" android:host="www.facebook.com" android:pathPrefix="/share/p/" />
                <data android:scheme="https" android:host="facebook.com" android:pathPrefix="/share/r/" />
                <data android:scheme="https" android:host="www.facebook.com" android:pathPrefix="/share/r/" />
            </intent-filter>

            <!-- Fallback: share a public link/text directly to Social Viewer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
